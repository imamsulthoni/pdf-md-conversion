# Copy to .env and adjust. All optional — defaults in app/config.py apply.
# Local dev: .\dev.ps1  (default http://127.0.0.1:8379)

# ---- Auth ----
# Bearer token for converter endpoints. Empty = open
# (local dev only); always set in any shared/deployed environment.
# /health stays open.
PDF_MD_CONVERTER_API_KEY=
# CORS: origins allowed to call the API directly from a browser.
# Comma-separated, no spaces:
# PLATFORM_URL=http://127.0.0.1:8378,https://app1.example.com,https://app2.example.com
PLATFORM_URL=http://127.0.0.1:8378

# ---- Upload & result lifetime ----
MAX_UPLOAD_MB=30
# Runtime data dir (jobs.sqlite for async conversion). Not served over HTTP.
# DATA_DIR=./data
# expires_at returned to the consumer; the consumer owns expiry cleanup.
PUBLIC_TTL_MINUTES=60

# ---- Extraction ----
MIN_TEXT_CHARS=50
PAGE_COVERAGE=0.5
RECURRING_XREF_RATIO=0.5
IMAGE_MIN_AREA_RATIO=0.01
MAX_IMAGE_MB=10
MAX_IMAGES_PER_DOC=200
# Table detection cost: when true, skip pdfplumber on pages where PyMuPDF
# already found a valid table (saves CPU; may miss a second table from a
# different engine on the same page). Default false = both engines run.
TABLE_FAST_MODE=false

# ---- OCR (RapidOCR, CPU-bound ~3-4s per full-res figure) ----
OCR_DPI=200
OCR_MIN_SIDE=1200
OCR_MAX_SCALE=2.0
OCR_MAX_PIXELS=9000000
# Cost guards: downscale figures above this longest side (px),
# skip OCR below this size (px, likely icons), cap OCR'd figures per doc.
OCR_MAX_SIDE=1600
OCR_SKIP_BELOW=100
OCR_MAX_IMAGES=100

# ---- Flowchart (local vector analysis, no LLM) ----
FLOWCHART_ENABLE=true
FLOWCHART_Y_TOL=10
FLOWCHART_MAX_SHAPES=200
FLOWCHART_SCORE_MIN=2

# ---- Async jobs (POST /convert/jobs) ----
CONVERT_JOB_TTL_MINUTES=120
CONVERT_MAX_QUEUE=4
